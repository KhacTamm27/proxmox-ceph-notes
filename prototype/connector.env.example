# Copy to /etc/pve-diagnostic/connector.env on the app VM.
# Replace values locally; never commit or send the populated file.
PVE_API_URL=https://pve.example:8006
PVE_API_TOKEN_ID=diagnostic@pve!read-only-token
PVE_API_TOKEN_SECRET=
PVE_CA_FILE=/etc/pve-diagnostic/pve-root-ca.pem
PVE_API_TIMEOUT=8
PVE_DIAG_BIND=127.0.0.1
PVE_DIAG_PORT=8765
