# Script và cấu hình chạy trên Linux: luôn giữ LF, kể cả khi clone trên Windows (core.autocrlf=true).
*.sh   text eol=lf
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.env.example text eol=lf
configs/**/*.interfaces text eol=lf
*.lua  text eol=lf
*.service text eol=lf
*.example text eol=lf
*.png binary
