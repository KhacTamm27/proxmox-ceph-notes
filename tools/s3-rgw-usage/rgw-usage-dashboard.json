          },
          "expr": "clamp_min(clamp_max(1 - (sum by (owner)(rate(radosgw_usage_successful_ops_total{owner=~\"$owner\",bucket=~\"$bucket\",category!=\"get_bucket_object_lock\"}[5m])) / sum by (owner)(rate(radosgw_usage_ops_total{owner=~\"$owner\",bucket=~\"$bucket\",category!=\"get_bucket_object_lock\"}[5m]))), 1), 0)",
          "legendFormat": "{{owner}}",
          "refId": "A",
